<?xml version="1.0" encoding="utf-8"?><navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/fragment_splash">

    <fragment
        tools:layout="@layout/fragment_splash"
        android:id="@+id/fragment_splash"
        android:name="com.example.kanban.ui.SplashFragment"
        android:label="SplashFragment" >
        <action
            android:id="@+id/action_fragment_splash_to_authentication"
            app:destination="@id/authentication"
            app:popUpTo="@id/fragment_splash"
            app:popUpToInclusive="true"
            />
    </fragment>

    <navigation
        android:id="@+id/authentication"
        app:startDestination="@id/fragment_login">

        <fragment
            tools:layout="@layout/fragment_login"
            android:id="@+id/fragment_login"
            android:name="com.example.kanban.ui.auth.LoginFragment"
            android:label="LoginFragment" >
            <action
                android:id="@+id/action_fragment_login_to_fragment_register"
                app:destination="@id/fragment_register" />
            <action
                android:id="@+id/action_fragment_login_to_fragment_recover_account"
                app:destination="@id/fragment_recover_account" />
        </fragment>

        <fragment
            tools:layout="@layout/fragment_register"
            android:id="@+id/fragment_register"
            android:name="com.example.kanban.ui.auth.RegisterFragment"
            android:label="RegisterFragment" />

        <fragment
            tools:layout="@layout/fragment_recover_account"
            android:id="@+id/fragment_recover_account"
            android:name="com.example.kanban.ui.auth.RecoverAccountFragment"
            android:label="RecoverAccountFragment" />
        <action
            android:id="@+id/action_global_homeFragment"
            app:destination="@id/homeFragment" />

    </navigation>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.kanban.ui.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" />

</navigation>
